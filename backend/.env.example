# Copy this file to .env and fill in what you need.

# Port for the API and web page.
PORT=8787

# Classifier: mock (fake demo scores), hive, or sightengine.
PROVIDER=mock

# Hive: https://thehive.ai  (AI-Generated & Deepfake Content Detection)
HIVE_API_KEY=

# Sightengine: https://sightengine.com  (has a free tier)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Optional: PEM file (or https URL) of trusted C2PA signing roots, so
# "verified camera capture" can be shown for trusted signers.
C2PA_TRUST_ANCHORS=

# Upload / download size cap in bytes (default 50 MB).
MAX_BYTES=52428800
